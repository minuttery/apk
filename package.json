{
  "name": "minuttery",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "android": "npm run android --workspace=minutteryapk --",
    "android:build": "npm run android:build --workspace=minutteryapk --",
    "build:apk": "npm run build:apk --workspace=minutteryapk --",
    "build": "npm run build --workspace=minutteryapk --",
    "ci": "npm run ci --workspace=minutteryapk --",
    "dev": "npm run dev --workspace=minutteryapk --",
    "doctor": "npm run doctor --workspace=minutteryapk --",
    "format": "npm run format --workspace=minutteryapk --",
    "format:check": "npm run format:check --workspace=minutteryapk --",
    "ios": "npm run ios --workspace=minutteryapk --",
    "lint": "npm run lint --workspace=minutteryapk --",
    "lint:check": "npm run lint:check --workspace=minutteryapk --",
    "start": "npm run start --workspace=minutteryapk --",
    "web": "npm run web --workspace=minutteryapk --"
  }
}
