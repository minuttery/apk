{
  "expo": {
    "name": "minuttery",
    "slug": "minutteryapk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minutteryapk",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0b0b",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f1ff0a"
      },
      "package": "com.anonymous.minutteryapk"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0a0b0b",
      "translucent": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1e2f158b-3ad3-4e51-9480-a0a78ebf61f5"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0b0b",
          "dark": {
            "backgroundColor": "#0a0b0b",
            "image": "./assets/images/splash-icon.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e2f158b-3ad3-4e51-9480-a0a78ebf61f5"
      }
    }
  }
}
